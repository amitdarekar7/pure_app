# Copy this file to .env.local and fill in your machine's LAN IP.
# Use this when testing on a physical device (iPhone/Android phone) that
# cannot reach "localhost" — it needs your Mac's actual network IP.
#
# Find your LAN IP:  ifconfig | grep "inet " | grep -v 127.0.0.1
#
# EXPO_PUBLIC_API_URL=http://192.168.1.XXX:3000
# EXPO_PUBLIC_SEARCH_URL=http://192.168.1.XXX:3001
# EXPO_PUBLIC_PAY_URL=http://192.168.1.XXX:3002
# EXPO_PUBLIC_AI_URL=http://192.168.1.XXX:3003
#
# Firebase web config — copy from .env and fill in your project values:
# EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
# EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
