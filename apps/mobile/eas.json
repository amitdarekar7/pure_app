{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_SEARCH_URL": "http://localhost:3001",
        "EXPO_PUBLIC_PAY_URL": "http://localhost:3002",
        "EXPO_PUBLIC_AI_URL": "http://localhost:3003"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.pureapp.in",
        "EXPO_PUBLIC_SEARCH_URL": "https://api.pureapp.in",
        "EXPO_PUBLIC_PAY_URL": "https://api.pureapp.in",
        "EXPO_PUBLIC_AI_URL": "https://api.pureapp.in"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.pureapp.in",
        "EXPO_PUBLIC_SEARCH_URL": "https://api.pureapp.in",
        "EXPO_PUBLIC_PAY_URL": "https://api.pureapp.in",
        "EXPO_PUBLIC_AI_URL": "https://api.pureapp.in"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "REPLACE_WITH_APPLE_ID",
        "ascAppId": "REPLACE_WITH_ASC_APP_ID",
        "appleTeamId": "REPLACE_WITH_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-key.json"
      }
    }
  }
}
