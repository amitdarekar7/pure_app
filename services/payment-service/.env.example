# Copy this file to .env and fill in values for local development.
# In production, set these via your deployment platform.
# Never commit .env — it is git-ignored.

# PostgreSQL — local: run: docker-compose up postgres-payments (maps to host port 5433)
# Docker-based: postgres://payments:payments_secret@localhost:5433/payments_db
DATABASE_URL=postgres://YOUR_PG_USER@localhost:5432/payments_db

PORT=3002
RUST_LOG=info
