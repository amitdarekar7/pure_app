# Copy this file to .env and fill in values for local development.
# In production, set these via your deployment platform (ECS task def, K8s secret, etc.)
# Never commit .env — it is git-ignored.

# PostgreSQL — local: use your native PG user/db, or run: docker-compose up postgres-core
# Docker-based:  postgres://core:core_secret@localhost:5432/core_db
DATABASE_URL=postgres://YOUR_PG_USER@localhost:5432/core_db

# Redis — local: brew services start redis, or run: docker-compose up redis
REDIS_URL=redis://localhost:6379

# JWT signing secret — must be a long random string in production
JWT_SECRET=local_dev_secret_change_in_production

NODE_ENV=development
PORT=3000
