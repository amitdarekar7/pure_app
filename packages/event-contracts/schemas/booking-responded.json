{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pure-app.io/events/booking-responded/v1",
  "title": "BookingResponded",
  "description": "Emitted by core-api when a provider accepts, rejects, or reschedules a booking. Consumers: core-api (SSE fan-out to user app).",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "timestamp", "aggregate_id", "data"],
  "additionalProperties": false,
  "properties": {
    "event_id":       { "type": "string", "format": "uuid" },
    "event_type":     { "type": "string", "const": "booking.responded" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "timestamp":      { "type": "string", "format": "date-time" },
    "aggregate_id":   { "type": "string", "format": "uuid", "description": "booking_id" },
    "data": {
      "type": "object",
      "required": [
        "booking_id", "user_id", "provider_id",
        "provider_name", "action", "new_status"
      ],
      "additionalProperties": false,
      "properties": {
        "booking_id":    { "type": "string", "format": "uuid" },
        "user_id":       { "type": "string", "format": "uuid" },
        "provider_id":   { "type": "string", "format": "uuid" },
        "provider_name": { "type": "string" },
        "action":        { "type": "string", "enum": ["confirm", "reject", "reschedule"] },
        "new_status":    { "type": "string", "enum": ["confirmed", "cancelled", "pending"] },
        "scheduled_at":  { "type": ["string", "null"], "format": "date-time" },
        "service_title": { "type": ["string", "null"] }
      }
    }
  }
}
