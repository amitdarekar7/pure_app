{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pure-app.io/events/user-registered/v1",
  "title": "UserRegistered",
  "description": "Emitted by core-api when a new user account is successfully created. Consumers: ai-service (cold-start profile), search-service (user index).",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "timestamp", "aggregate_id", "data"],
  "additionalProperties": false,
  "properties": {
    "event_id":       { "type": "string", "format": "uuid" },
    "event_type":     { "type": "string", "const": "user.registered" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "timestamp":      { "type": "string", "format": "date-time" },
    "aggregate_id":   { "type": "string", "format": "uuid", "description": "user_id" },
    "data": {
      "type": "object",
      "required": ["user_id", "email"],
      "additionalProperties": false,
      "properties": {
        "user_id":      { "type": "string", "format": "uuid" },
        "email":        { "type": "string", "format": "email" },
        "display_name": { "type": "string" },
        "locale":       { "type": "string", "default": "en-US" }
      }
    }
  }
}
