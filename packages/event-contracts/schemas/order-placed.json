{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pure-app.io/events/order-placed/v1",
  "title": "OrderPlaced",
  "description": "Emitted by core-api when a user places an order. Consumers: payment-service (create payment intent), ai-service (purchase signal for retraining).",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "timestamp", "aggregate_id", "data"],
  "additionalProperties": false,
  "properties": {
    "event_id":       { "type": "string", "format": "uuid" },
    "event_type":     { "type": "string", "const": "order.placed" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "timestamp":      { "type": "string", "format": "date-time" },
    "aggregate_id":   { "type": "string", "format": "uuid", "description": "order_id" },
    "data": {
      "type": "object",
      "required": ["order_id", "user_id", "items", "total_cents", "currency"],
      "additionalProperties": false,
      "properties": {
        "order_id":    { "type": "string", "format": "uuid" },
        "user_id":     { "type": "string", "format": "uuid" },
        "total_cents": { "type": "integer", "minimum": 1 },
        "currency":    { "type": "string", "pattern": "^[A-Z]{3}$" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["item_id", "quantity", "price_cents"],
            "additionalProperties": false,
            "properties": {
              "item_id":     { "type": "string" },
              "quantity":    { "type": "integer", "minimum": 1 },
              "price_cents": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
