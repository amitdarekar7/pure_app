{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pure-app.io/events/payment-completed/v1",
  "title": "PaymentCompleted",
  "description": "Emitted by payment-service when a payment is successfully captured and the ledger entry is written. Consumers: core-api (fulfil order), ai-service (confirmed purchase signal).",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "timestamp", "aggregate_id", "data"],
  "additionalProperties": false,
  "properties": {
    "event_id":       { "type": "string", "format": "uuid" },
    "event_type":     { "type": "string", "const": "payment.completed" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "timestamp":      { "type": "string", "format": "date-time" },
    "aggregate_id":   { "type": "string", "format": "uuid", "description": "payment_intent_id" },
    "data": {
      "type": "object",
      "required": ["payment_intent_id", "user_id", "amount_cents", "currency", "processor_ref", "ledger_entry_id"],
      "additionalProperties": false,
      "properties": {
        "payment_intent_id": { "type": "string", "format": "uuid" },
        "user_id":           { "type": "string", "format": "uuid" },
        "amount_cents":      { "type": "integer", "minimum": 1 },
        "currency":          { "type": "string", "pattern": "^[A-Z]{3}$" },
        "processor_ref":     { "type": "string", "description": "Stripe/Braintree transaction ID" },
        "ledger_entry_id":   { "type": "string", "format": "uuid" }
      }
    }
  }
}
